+/// Converts a packed u32 color to an underline-color SGR fragment (SGR 58).
+///
+/// Returns `None` for `Color::Reset`, since `build_sgr` already prefixes every
+/// sequence with SGR 0, which resets the underline color to "follow the
+/// foreground". Colon sub-parameters are used because that is the form the
+/// `Setulc` terminfo capability advertises, and the only one some terminals
+/// accept.
+fn color_to_sgr_underline(val: u32) -> Option<String> {
+    match val >> 24 {
+        0x00 => match val & 0xFF {
+            0x00 => None, // Reset → inherit foreground
+            // Named colors map onto the first 16 palette entries in the same
+            // order `color_to_sgr_fg` uses for 30–37/90–97.
+            named @ 0x01..=0x10 => Some(format!("58:5:{}", named - 1)),
+            _ => None,
+        },
+        0x01 => Some(format!("58:5:{}", val & 0xFF)), // Indexed
+        0x02 => {
+            let r = (val >> 16) & 0xFF;
+            let g = (val >> 8) & 0xFF;
+            let b = val & 0xFF;
+            // The empty field after `2` is the (unused) color-space id.
+            Some(format!("58:2::{r}:{g}:{b}"))
+        }
+        _ => None,
+    }
+}
